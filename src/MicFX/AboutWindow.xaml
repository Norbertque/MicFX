<Window x:Class="MicFX.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About MicFX"
        Width="460" SizeToContent="Height"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="MicFX" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="txtVersion" Text="Version" FontSize="11"
                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,12"/>

        <TextBlock Text="Copyright (C) 2026 Norbertque"/>
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                   Foreground="{StaticResource SubtleTextBrush}"
                   Text="This program comes with ABSOLUTELY NO WARRANTY. It is free software: you are welcome to redistribute and modify it under the terms of the GNU General Public License, version 3 or (at your option) any later version."/>
        <TextBlock Margin="0,10,0,0" FontSize="12">
            <Run Text="Source code: " Foreground="{StaticResource SubtleTextBrush}"/>
            <Hyperlink x:Name="lnkSource" Click="Source_Click" Foreground="{DynamicResource AccentHoverBrush}">
                <Run x:Name="runSource" Text="github.com"/>
            </Hyperlink>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                   Foreground="{StaticResource SubtleTextBrush}"
                   Text="Includes NAudio (MIT), RNNoise (BSD-3-Clause) and the .NET runtime (MIT)."/>

        <TextBox x:Name="txtDocument" Visibility="Collapsed" IsReadOnly="True"
                 Height="320" Margin="0,12,0,0" Padding="6,4"
                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource PanelBrush}"
                 Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource BorderBrush}"/>

        <DockPanel Margin="0,14,0,0">
            <Button Content="Close" DockPanel.Dock="Right" Width="80" IsCancel="True" IsDefault="True"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnLicense" Content="License" Style="{StaticResource SubtleButton}"
                        Click="License_Click"/>
                <Button x:Name="btnNotices" Content="Third-party notices" Margin="6,0,0,0"
                        Style="{StaticResource SubtleButton}" Click="Notices_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
